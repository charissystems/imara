# ──────────────────────────────────────────────────────────────────────────────
# Imara SACCO – Environment Variables
# Copy this file to .env and replace all placeholder values with real secrets.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Published ports (host → container) ────────────────────────────────────────
# Change these if the default ports conflict with other local services.
API_PORT_PUBLISHED=3000
DB_PORT_PUBLISHED=5433
REDIS_PORT_PUBLISHED=6380

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=imara_db
DB_POOL_MAX=20

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_DB=0

# ── Auth secrets (minimum 32 characters each) ──────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret-min-32-chars

# ── Application ────────────────────────────────────────────────────────────────
ENABLE_JOB_SCHEDULER=true
ADMIN_SECRET_KEY=replace-with-a-secure-admin-secret-minimum-32-characters
BASE_DOMAIN=localhost
FRONTEND_URL=http://localhost:5173

# ── CORS (comma-separated origins; required in production) ─────────────────────
# ALLOWED_ORIGINS=https://app.yourdomain.com
