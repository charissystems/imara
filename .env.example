# ── Imara SACCO Platform – Environment Variables ─────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── General ──────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT_PUBLISHED=3000

# ── PostgreSQL ───────────────────────────────────────────────────────
DB_USER=imara
DB_PASSWORD=          # REQUIRED – set a strong password
DB_NAME=imara
DB_PORT_PUBLISHED=5432
DB_POOL_MAX=20

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=       # REQUIRED – set a strong password
REDIS_DB=0
REDIS_PORT_PUBLISHED=6379

# ── Authentication ───────────────────────────────────────────────────
JWT_SECRET=           # REQUIRED – minimum 32 characters
REFRESH_TOKEN_SECRET= # REQUIRED – minimum 32 characters

# ── Job Scheduler ───────────────────────────────────────────────────
ENABLE_JOB_SCHEDULER=true

# ── Email / SMTP (optional) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
